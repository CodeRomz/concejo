<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

  <!-- A) Share dialog titles -->
  <t t-name="concejo.SlideShareDialog.inherit"
     t-inherit="website_slides.SlideShareDialog"
     t-inherit-mode="extension">
    <!-- Channel case -->
    <xpath expr="//t[@t-set='title' and @t-if='this.props.isChannel']" position="replace">
      <t t-if="this.props.isChannel" t-set="title">Share these Documents</t>
    </xpath>
    <!-- Non-channel (single item) case -->
    <xpath expr="//t[@t-set='title' and @t-else='']" position="replace">
      <t t-else="" t-set="title">Share this Document</t>
    </xpath>
  </t>

  <!-- B) Email sharing: login message -->
  <t t-name="concejo.EmailSharingInput.inherit"
     t-inherit="website_slides.EmailSharingInput"
     t-inherit-mode="extension">
    <xpath expr="//div[contains(@class,'alert-info')]/span[@t-if='this.isWebsiteUser']" position="replace">
      <span t-if="this.isWebsiteUser">
        Please <a t-attf-href="/odoo?redirect={{ window.location.href }}" class="fw-bold"> login </a>
        to share these documents by email.
      </span>
    </xpath>
  </t>

  <!-- C) Unsubscribe / leave dialog wording -->
  <t t-name="concejo.SlideUnsubscribeDialog.inherit"
     t-inherit="website_slides.SlideUnsubscribeDialog"
     t-inherit-mode="extension">

    <!-- Subscription checkbox label -->
    <xpath expr="//t[@t-if='state.mode === \u0027subscription\u0027']//CheckBox[@name='subscribed']" position="replace">
      <CheckBox value="isChecked" name="subscribed" onChange="(isChecked) => this.onChangeCheckbox(isChecked)">
        Be notified when new documents are added.
      </CheckBox>
    </xpath>

    <!-- Leave confirmation texts -->
    <xpath expr="//t[@t-if='state.mode === \u0027leave\u0027']/p[1]" position="replace">
      <p>Do you really want to leave these documents?</p>
    </xpath>
    <xpath expr="//t[@t-if='state.mode === \u0027leave\u0027']/p[2]" position="replace">
      <p>All progress will be lost until you rejoin these documents.</p>
    </xpath>

    <!-- Footer buttons -->
    <xpath expr="//t[@t-set-slot='footer']/t[@t-if='state.mode === \u0027subscription\u0027']/button[contains(@class,'btn-danger')]" position="replace">
      <button class="btn btn-danger ms-auto" t-att-disabled="state.buttonDisabled" t-on-click="() => this.onClickLeaveCourse()">or Leave the documents</button>
    </xpath>
    <xpath expr="//t[@t-set-slot='footer']/t[@t-if='state.mode === \u0027leave\u0027']/button[1]" position="replace">
      <button class="btn btn-danger" t-att-disabled="state.buttonDisabled" t-on-click="() => this.onClickLeaveCourseSubmit()">Leave the documents</button>
    </xpath>
  </t>

</templates>
