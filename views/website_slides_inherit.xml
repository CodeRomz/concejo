<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1) Header + search -->
    <template id="concejo_course_nav_docs" inherit_id="website_slides.course_nav">
        <xpath expr="//ol[contains(concat(' ', normalize-space(@class), ' '), ' breadcrumb ')]//a[@href='/slides']"
               position="replace">
            <a href="/slides" title="Documents">Documents</a>
        </xpath>
        <xpath expr="//t[@t-set='placeholder']" position="replace">
            <t t-set="placeholder">Search documents</t>
        </xpath>
    </template>

    <!-- 2) Generic join link -->
    <template id="concejo_join_course_link_docs" inherit_id="website_slides.join_course_link">
        <xpath expr="//a[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_course_join_link ')]"
               position="replace">
            <a class="o_wslides_js_course_join_link" href="#"
               t-att-data-channel-enroll="slide.channel_id.enroll"
               t-att-data-channel-id="slide.channel_id.id">
                Access the Documents
            </a>
        </xpath>
    </template>

    <!-- 3) Sidebar CTA / enrolled / lock / prerequisites -->
    <template id="concejo_course_join_cta_docs" inherit_id="website_slides.course_join">
        <xpath expr="//a[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_course_join_link ')]"
               position="attributes">
            <attribute name="title">Access the Documents</attribute>
            <attribute name="aria-label">Access the Documents</attribute>
        </xpath>
        <xpath expr="//a[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_course_join_link ')]//span[contains(@class,'cta-title')]"
               position="replace">
            <span class="cta-title text_small_caps">Access the Documents</span>
        </xpath>
        <xpath expr="//span[normalize-space()='Course Locked']" position="replace">
            <span>Documents Locked</span>
        </xpath>
        <xpath expr="//button[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_channel_unsubscribe ')]//h6"
               position="replace">
            <h6 class="d-flex flex-grow-1 my-0">You have access to these documents</h6>
        </xpath>
        <xpath expr="//a[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_prerequisite_course ')]"
               position="replace">
            <a href="#" class="o_wslides_js_prerequisite_course"
               t-att-data-channels="json.dumps(
           [{'course_id': course.id, 'course_name': course.name}
            for course in channel.prerequisite_channel_ids]
         )">documents
            </a>
        </xpath>
    </template>

    <!-- 4) Main tab label -->
    <template id="concejo_course_main_docs" inherit_id="website_slides.course_main">
        <xpath expr="//a[@id='home-tab']" position="replace">
            <a t-att-class="'nav-link %s' % ('active' if active_tab == 'home' else '')"
               id="home-tab" data-bs-toggle="pill" href="#home" role="tab" aria-controls="home"
               t-att-aria-selected="'true' if active_tab == 'home' else 'false'">
                <i class="fa fa-home"/>
                Documents
            </a>
        </xpath>
    </template>

    <!-- ==============================
         HOME: website_slides.courses_home
         ============================== -->
    <template id="override_courses_home_copy"
              inherit_id="website_slides.courses_home"
              name="Docs: Home copy/labels"
              priority="20">

        <!-- Banner H2: replace the H2 inside the first banner (no text matching) -->
        <xpath expr="(//div[@class='oe_structure oe_empty']//section[contains(@class,'s_banner')]//h2)[1]"
               position="replace">
            <h2 class="mb-4">Start exploring documents today!</h2>
        </xpath>

        <!-- Banner paragraph below the H2 -->
        <xpath expr="(//div[@class='oe_structure oe_empty']//section[contains(@class,'s_banner')]//div[@class='row mt-1 mb-3']//p)[1]"
               position="replace">
            <p>Skill up and have an impact! Your business career starts here.<br/>Time to start a document.
            </p>
        </xpath>

        <!-- Search placeholder in navbar -->
        <xpath expr="//nav[contains(@class,'navbar')]//t[@t-set='placeholder']"
               position="replace">
            <t t-set="placeholder">Search documents</t>
        </xpath>

        <!-- 'All courses' link -->
        <xpath expr="//a[contains(@class,'o_wslides_home_all_slides')]"
               position="replace">
            <a class="nav-link nav-link me-md-2 o_wslides_home_all_slides" href="/slides/all">
                <i class="fa fa-graduation-cap me-1"/>All documents
            </a>
        </xpath>

        <!-- Empty state -->
        <xpath expr="//div[contains(@class,'o_wslides_home_content_section') and @t-if='not channels_popular']//p[@class='h2']"
               position="replace">
            <p class="h2">No Document created yet.</p>
        </xpath>
        <xpath expr="//div[contains(@class,'o_wslides_home_content_section') and @t-if='not channels_popular']//p[@groups='website_slides.group_website_slides_officer']"
               position="replace">
            <p groups="website_slides.group_website_slides_officer">Click on "New" in the top-right corner to create
                your first document.
            </p>
        </xpath>

        <!-- Section titles -->
        <xpath expr="//div[@class='row o_wslides_home_content_section_title align-items-center']//h5[text()='My courses']"
               position="replace">
            <h5 class="m-0">My documents</h5>
        </xpath>
        <xpath expr="//div[@class='row o_wslides_home_content_section_title align-items-center']//h5[text()='Most popular courses']"
               position="replace">
            <h5 class="m-0">Most popular documents</h5>
        </xpath>
        <xpath expr="//div[@class='row o_wslides_home_content_section_title align-items-center']//h5[text()='Newest courses']"
               position="replace">
            <h5 class="m-0">Newest documents</h5>
        </xpath>
    </template>

    <!-- ==============================
         ALL: website_slides.courses_all
         ============================== -->
    <template id="override_courses_all_copy"
              inherit_id="website_slides.courses_all"
              name="Docs: All headers/search/empty states"
              priority="20">

        <!-- Banner H1 when 'My' -->
        <xpath expr="//div[@class='oe_structure oe_empty' and @t-if='search_my']//section[contains(@class,'s_banner')]//h1"
               position="replace">
            <h1 class="display-3 mb-0 text-white">My Documents</h1>
        </xpath>

        <!-- Banner H1 when 'All' (else branch) -->
        <xpath expr="//div[@class='oe_structure oe_empty' and @t-else='']//section[contains(@class,'s_banner')]//h1"
               position="replace">
            <h1 class="display-3 mb-0 text-white">All Documents</h1>
        </xpath>

        <!-- Search placeholders (mobile & desktop) -->
        <xpath expr="//nav[contains(@class,'navbar')]//t[@t-set='placeholder']"
               position="replace">
            <t t-set="placeholder">Search documents</t>
        </xpath>

        <!-- Tag chip 'My Courses' (inside t-if='search_my') -->
        <xpath expr="//t[@t-if='search_my']/span[contains(@class,'d-inline-flex')]"
               position="replace">
            <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2">
                <i class="fa fa-tag me-2 text-muted"/>
                My Documents
                <span t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids), search=search_term, prevent_redirect=True)"
                      class="post_link cursor-pointer btn border-0 py-1">&#215;
                </span>
            </span>
        </xpath>

        <!-- Empty states -->
        <xpath expr="//div[@class='container o_wslides_home_main pb-5']//p[@class='h2']"
               position="replace">
            <p class="h2">No Document created yet.</p>
        </xpath>

        <xpath expr="//div[@class='container o_wslides_home_main pb-5']/div[@class='alert alert-info mb-5' and @t-elif='search_term and not channels']"
               position="replace">
            <div class="alert alert-info mb-5">
                No document was found matching your search
                <code>
                    <t t-esc="search_term"/>
                </code>
                .
            </div>
        </xpath>

        <xpath expr="//div[@class='container o_wslides_home_main pb-5']/div[@class='alert alert-info mb-5' and @t-elif='not channels']"
               position="replace">
            <div class="alert alert-info mb-5">
                No document was found matching your search.
            </div>
        </xpath>
    </template>

</odoo>
